    "applicationDisplayName": "Codex",
    "processOrBundleName": "chatgpt",
    "deviceType": "Loupedeck20",
    "modeName": "main",
    "version": "1.1.0"
  },
  "palette": {
    "background": "#0B0F14",
    "foreground": "#F8FAFC",
    "muted": "#94A3B8",
    "commands": "#2563EB",
    "agents": "#0891B2",
    "skills": "#7C3AED",
    "text": "#059669",
    "reasoning": "#EA580C",
    "system": "#CA8A04"
  },
  "pages": [
    {
      "id": "commands",
      "name": "Commands",
      "color": "commands",
      "buttons": [
        "new_chat", "quick_chat", "side_chat",
        "search_chats", "open_folder", "command_menu",
        "review_tab", "toggle_terminal", "toggle_bottom",
        "toggle_sidebar", "dictation", "shortcut_help"
      ]
    },
    {
